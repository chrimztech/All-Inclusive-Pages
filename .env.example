# ---- Web app ----
# Frontend -> backend API base URL (no trailing slash).
VITE_API_URL=http://localhost:8081/api/v1

# ---- Docker Compose (docker compose up --build) ----
# Database
DB_NAME=eoz_db
DB_USER=postgres
DB_PASSWORD=11111111
DB_HOST_PORT=5433

# Security: replace all three with long random values outside local development.
JWT_SECRET=dev-only-change-me-eoz-platform-secret-key-please-rotate-in-prod
# Encrypts stored two-step verification keys. Keep it stable once set.
EOZ_DATA_KEY=
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me

# Web-app origins allowed to call the API with cookies (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8082

# Outgoing email. Defaults send to the bundled Mailpit (web UI on MAIL_UI_PORT).
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_UI_PORT=8025

# Public addresses written into emails (unsubscribe links).
PUBLIC_WEB_URL=http://localhost:8082
PUBLIC_API_URL=http://localhost:8081/api/v1

# Backups kept on disk; older ones are deleted after each nightly backup.
BACKUP_KEEP=14
# local = bundled common-password list; hibp = also check Have I Been Pwned (k-anonymity).
BREACHED_PASSWORD_CHECK=local
# native when running behind Nginx/a load balancer (real client IPs for audit and rate limits).
FORWARD_HEADERS_STRATEGY=none
# Set to demo to load fictional demonstration data once (development only).
#SPRING_PROFILES_ACTIVE=demo

BACKEND_HOST_PORT=8081
API_DOCS_ENABLED=true
